#!/bin/bash
# Build DKMS modules against kernel headers the way a machine does on an
# update: install the headers, then `dkms build` each module source tree for
# each kernel. A kernel that renames or drops something an out-of-tree module
# uses fails here instead of on users' machines (linux-omarchy 7.2.8-9 renamed
# battery_hook_register, and the TUXEDO modules stopped building).
#
# Only what changes is checked: a kernel/module pair builds when either side is
# a package in --local (a pull request's fresh build) or a package whose
# version differs from --since's (a promotion). With neither, everything is.
# --packages narrows that to the named packages or pkgbases.
#
# Some DKMS packages Omarchy installs come from Arch's own repositories, not
# from this one (ci/dkms-packages marks them repo=<name>). They are read from
# the channel's Arch mirror, the snapshot that channel's machines install
# from. They never move with this repository, so they are checked whenever a
# kernel changes; --from-repos checks them against every kernel, for the daily
# run that catches Arch updating them.
#
# Usage:
#   bin/check-dkms plan --arch <arch> --files-db <omarchy.files>
#                       [--local <dir>] [--since-db <omarchy.files>]
#                       [--repo-files-db <repo>=<repo.files> ...] [--from-repos]
#       Print the kernels, the DKMS packages and the pairs a run would build.
#   bin/check-dkms run --arch <arch> --channel <channel> [--local <dir>] [--since <channel>]
#                      [--packages "<name|pkgbase> ..."] [--from-repos]
#       Run the check, as root, in a disposable Arch (x86_64) or Arch Linux ARM
#       (aarch64) system: it installs packages.
#   bin/check-dkms container <same options as run>
#       Run it in a throwaway container of the right image (needs Docker).
#   bin/check-dkms needs --arch <arch> --local <dir> [--channel <channel> | --files-db <omarchy.files>]
#       Exit 0 when <dir> holds a kernel or DKMS package for <arch>, or a
#       package the channel publishes as one (so losing that role is caught).
#   bin/check-dkms fingerprint --arch <arch> --channel <channel>
#       Print the versions a --from-repos run depends on (curl and tar only).
set -euo pipefail

ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
REGISTRY=${OMARCHY_DKMS_REGISTRY:-$ROOT/ci/dkms-packages}
PKGS_BASE=${OMARCHY_PKGS_BASE:-https://pkgs.omarchy.org}
X86_64_IMAGE=${OMARCHY_DKMS_X86_64_IMAGE:-ghcr.io/archlinux/archlinux:base-devel}
AARCH64_IMAGE=${OMARCHY_DKMS_AARCH64_IMAGE:-ghcr.io/menci/archlinuxarm@sha256:3e1074c407fc1a57c2a2117af6920c96a7cc906fa6f1f2da8a4a7fd3aa2c2f4e}

die() { echo "check-dkms: $*" >&2; exit 2; }
usage() { sed -n '20,35p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

mode=${1:-}
[[ -n $mode ]] || usage
shift
arch="" channel="" files_db="" local_dir="" since="" since_db="" only="" from_repos=0
repo_dbs=()
while (($#)); do
  case $1 in
    --arch) arch=${2:?--arch needs a value}; shift 2 ;;
    --channel) channel=${2:?--channel needs a value}; shift 2 ;;
    --files-db) files_db=${2:?--files-db needs a value}; shift 2 ;;
    --local) local_dir=${2:?--local needs a value}; shift 2 ;;
    --since) since=${2:?--since needs a value}; shift 2 ;;
    --since-db) since_db=${2:?--since-db needs a value}; shift 2 ;;
    --packages) only=${2-}; shift 2 ;;
    --repo-files-db) repo_dbs+=("${2:?--repo-files-db needs <repo>=<file>}"); shift 2 ;;
    --from-repos) from_repos=1; shift ;;
    *) usage ;;
  esac
done
case $arch in x86_64 | aarch64) ;; *) die "--arch must be x86_64 or aarch64" ;; esac
# run downloads repo= packages from the channel's mirror; plan only lists them.
REPO_CHANNEL=""
[[ $mode != run ]] || REPO_CHANNEL=$channel
if [[ -n $local_dir ]]; then
  [[ -d $local_dir ]] || die "--local $local_dir is not a directory"
fi

# The DKMS packages ci/dkms-packages lists for this architecture, and the
# kernels each is limited to ("<package> <headers>,..."; none means every one).
LISTED=$(awk -v a="$arch" '!/^[[:space:]]*(#|$)/ { for (i = 2; i <= NF; i++) if ($i == a) print $1 }' "$REGISTRY")
SCOPES=$(awk -v a="$arch" '!/^[[:space:]]*(#|$)/ {
    ok = 0; k = ""
    for (i = 2; i <= NF; i++) { if ($i == a) ok = 1; if ($i ~ /^kernels=/) k = substr($i, 9) }
    if (ok && k != "") print $1 "\t" k
  }' "$REGISTRY")
is_listed() { grep -qxF -- "$1" <<<"$LISTED"; }
# The listed packages that come from an Arch repository: "<package> <repo>".
REPOS=$(awk -v a="$arch" '!/^[[:space:]]*(#|$)/ {
    ok = 0; r = ""
    for (i = 2; i <= NF; i++) { if ($i == a) ok = 1; if ($i ~ /^repo=/) r = substr($i, 6) }
    if (ok && r != "") print $1 "\t" r
  }' "$REGISTRY")
from_repo() { awk -F'\t' -v n="$1" '$1 == n { f = 1 } END { exit !f }' <<<"$REPOS"; }
# The repo= packages this plan really takes from Arch: those this repository
# does not build itself. Set by plan_for; empty when none were needed.
ARCH_SOURCED=""

# Where a channel's machines get Arch packages, x86_64 per channel
# (default/pacman/mirrorlist-* in omacom/omarchy), aarch64 one mirror for all.
# Printed as pacman Server lines: $repo and $arch stay literal.
# shellcheck disable=SC2016
mirror_server() {
  if [[ $arch == aarch64 ]]; then
    echo 'https://arm-mirror.omarchy.org/$arch/$repo'
    return
  fi
  case $1 in
    edge) echo 'https://mirror.omarchy.org/$repo/os/$arch' ;;
    rc) echo 'https://rc-mirror.omarchy.org/$repo/os/$arch' ;;
    stable) echo 'https://stable-mirror.omarchy.org/$repo/os/$arch' ;;
    *) die "no Arch mirror is known for channel $1" ;;
  esac
}
# The URL of an Arch repository's directory for a channel.
repo_url() { # repo_url <channel> <repo>
  local server
  server=$(mirror_server "$1")
  server=${server//\$repo/$2}
  echo "${server//\$arch/$arch}"
}

# A package's role from its file list on stdin: "kernel <kver>" for headers
# with a build tree, "dkms <tree>[,<tree>]" for DKMS sources, else "other".
# A transitional headers package that ships no tree is "other".
classify() {
  awk '
    /^usr\/lib\/modules\/[^\/]+\/build\/Makefile$/ { split($0, p, "/"); kver = p[4] }
    /^usr\/src\/[^\/]+\/dkms.conf$/ { split($0, p, "/"); trees = trees (trees == "" ? "" : ",") p[3] }
    END { if (kver != "") print "kernel\t" kver; else if (trees != "") print "dkms\t" trees; else print "other\t-" }'
}

# Every package of a files database, one line each:
#   <kind> <name> <version> <file> <sha256> <kver|trees|-> <pkgbase>
read_db() {
  local db=$1 dir
  dir=$(mktemp -d)
  bsdtar -xf "$db" -C "$dir" || { rm -rf "$dir"; die "cannot read $db"; }
  read_entries "$dir" "$db" "" || { rm -rf "$dir"; exit 2; }
  rm -rf "$dir"
}

read_entries() { # read_entries <unpacked db> <db, for errors> <file prefix>
  local dir=$1 db=$2 prefix=$3 entry name version file sha base role
  for entry in "$dir"/*/; do
    [[ -f $entry/desc ]] || continue
    [[ -f $entry/files ]] || { echo "check-dkms: $db is not a files database (no file lists)" >&2; return 1; }
    name=$(awk '$0 == "%NAME%" { getline; print; exit }' "$entry/desc")
    version=$(awk '$0 == "%VERSION%" { getline; print; exit }' "$entry/desc")
    file=$(awk '$0 == "%FILENAME%" { getline; print; exit }' "$entry/desc")
    sha=$(awk '$0 == "%SHA256SUM%" { getline; print; exit }' "$entry/desc")
    base=$(awk '$0 == "%BASE%" { getline; print; exit }' "$entry/desc")
    role=$(classify <"$entry/files")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${role%%$'\t'*}" "$name" "$version" "$prefix$file" "$sha" "${role#*$'\t'}" "${base:-$name}"
  done
}

# The repo= packages, read from their Arch repositories' files databases
# (<repo>=<file> pairs). Only their own entries are unpacked: a repository
# holds thousands. A listed package missing from its repository, or one that
# ships no DKMS tree there, is an error. With a channel, file names become URLs
# on that channel's mirror, so fetch downloads them from there.
read_repos() { # read_repos <channel or ""> <repo>=<file>...
  local channel=$1 spec repo db dir name line prefix out="" patterns=() names=()
  shift
  for spec in "$@"; do
    repo=${spec%%=*} db=${spec#*=}
    mapfile -t names < <(awk -F'\t' -v r="$repo" '$2 == r { print $1 }' <<<"$REPOS")
    ((${#names[@]})) || continue
    [[ -f $db ]] || die "no files database for repository $repo ($db)"
    patterns=()
    for name in "${names[@]}"; do patterns+=("$name-[0-9]*"); done
    dir=$(mktemp -d)
    # bsdtar complains about a pattern that matches nothing; checked below.
    bsdtar -xf "$db" -C "$dir" "${patterns[@]}" 2>/dev/null || true
    prefix=""
    [[ -z $channel ]] || prefix="$(repo_url "$channel" "$repo")/"
    line=$(read_entries "$dir" "$db" "$prefix") || { rm -rf "$dir"; exit 2; }
    rm -rf "$dir"
    for name in "${names[@]}"; do
      awk -F'\t' -v n="$name" '$1 == "dkms" && $2 == n { f = 1 } END { exit !f }' <<<"$line" ||
        die "$name is listed as coming from $repo, but $repo has no DKMS package of that name"
    done
    out+=$(awk -F'\t' 'FNR == 1 { file++ } file == 1 { w[$0] = 1; next } ($2 in w)' \
      <(printf '%s\n' "${names[@]}") <(printf '%s\n' "$line"))$'\n'
  done
  while IFS=$'\t' read -r name repo; do
    [[ -n $name ]] || continue
    grep -q "^dkms"$'\t'"$name"$'\t' <<<"$out" || die "no files database given for $name's repository, $repo"
  done <<<"$REPOS"
  printf '%s' "$out" | sed '/^$/d'
}

# The same lines for the packages in --local built for this architecture.
read_local() {
  local pkg info name version parch base list role found=0
  for pkg in "$local_dir"/*.pkg.tar.*; do
    [[ -f $pkg && $pkg != *.sig ]] || continue
    info=$(bsdtar -xOf "$pkg" .PKGINFO) || die "cannot read $pkg"
    name=$(awk -F' = ' '$1 == "pkgname" { print $2; exit }' <<<"$info")
    version=$(awk -F' = ' '$1 == "pkgver" { print $2; exit }' <<<"$info")
    parch=$(awk -F' = ' '$1 == "arch" { print $2; exit }' <<<"$info")
    base=$(awk -F' = ' '$1 == "pkgbase" { print $2; exit }' <<<"$info")
    [[ -n $name && -n $version ]] || die "$pkg has no pkgname or pkgver"
    [[ $parch == "$arch" || $parch == any ]] || continue
    list=$(bsdtar -tf "$pkg") || die "cannot list $pkg"
    role=$(classify <<<"$list")
    printf '%s\t%s\t%s\t%s\t-\t%s\t%s\n' "${role%%$'\t'*}" "$name" "$version" "$pkg" "${role#*$'\t'}" "${base:-$name}"
    found=1
  done
  ((found)) || die "--local $local_dir holds no package for $arch"
}

# The packages a check runs over: the channel's, with --local's in place of
# the published ones of the same name. A local package that no longer ships
# the headers tree or dkms.conf its published one did is an error: the
# published one must not quietly stand in for it.
compose() {
  local published=$1 fresh=$2 kind name pkind
  while IFS=$'\t' read -r kind name _; do
    [[ -n $name ]] || continue
    pkind=$(awk -F'\t' -v n="$name" '$2 == n { print $1; exit }' <<<"$published")
    if [[ -n $pkind && $pkind != other && $kind != "$pkind" ]]; then
      die "the local $name is a '$kind' package, but the published one is '$pkind'"
    fi
  done <<<"$fresh"
  {
    [[ -z $fresh ]] || printf '%s\n' "$fresh"
    awk -F'\t' 'FNR == 1 { file++ } file == 1 { if ($2 != "") seen[$2] = 1; next } $2 != "" && !($2 in seen)' \
      <(printf '%s\n' "$fresh") <(printf '%s\n' "$published")
  } | awk -F'\t' '$1 == "kernel" || $1 == "dkms"' | sort -t$'\t' -k1,1 -k2,2
}

# The names a check is about: --local's, or those whose version differs from
# --since's (missing there counts), or with neither option every one.
changed_names() {
  local names
  names=$(changed_unfiltered "$@")
  if ((from_repos)); then
    names=$ARCH_SOURCED
  fi
  if [[ -n $only ]]; then
    # Keep a name when it, or its pkgbase, is one of --packages.
    awk -F'\t' -v only=" $only " 'FNR == 1 { file++ } file == 1 { if ($1 != "") keep[$1] = 1; next }
      ($2 in keep) && (index(only, " " $2 " ") || index(only, " " $7 " ")) { print $2 }' \
      <(printf '%s\n' "$names") <(printf '%s\n' "$1")
  else
    printf '%s\n' "$names"
  fi
}

changed_unfiltered() {
  local packages=$1 fresh=$2 previous=$3
  if [[ -n $fresh ]]; then
    cut -f2 <<<"$fresh"
  elif [[ -n $previous ]]; then
    # A package taken from Arch does not move with a promotion: it pairs
    # through kernels. This repository's own copy of a repo= name does move.
    awk -F'\t' 'FNR == 1 { file++ } file == 1 { if ($0 != "") r[$0] = 1; next }
      file == 2 { v[$2] = $3; next } $2 != "" && v[$2] != $3 && !($2 in r) { print $2 }' \
      <(printf '%s\n' "$ARCH_SOURCED") <(printf '%s\n' "$previous") <(printf '%s\n' "$packages")
  else
    cut -f2 <<<"$packages"
  fi
}

# Every published DKMS package must be in the registry; a listed one that this
# channel does not publish is only noted.
check_registry() {
  local packages=$1 status=0 kind name
  while IFS=$'\t' read -r kind name _; do
    [[ $kind == dkms ]] || continue
    if ! is_listed "$name"; then
      echo "check-dkms: $name ships a DKMS module for $arch but is not in ci/dkms-packages" >&2
      status=1
    fi
  done <<<"$packages"
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    from_repo "$name" && continue
    awk -F'\t' -v n="$name" '$1 == "dkms" && $2 == n { f = 1 } END { exit !f }' <<<"$packages" ||
      echo "check-dkms: note: $name is listed for $arch but not published here" >&2
  done <<<"$LISTED"
  return "$status"
}

# The kernel/module pairs to build: "<kernel name> <kver> <dkms name> <tree>".
pairs() {
  local packages=$1 changed=$2
  awk -F'\t' '
    FNR == 1 { file++ }
    file == 1 { if ($1 != "") scope[$1] = "," $2 ","; next }
    file == 2 { if ($1 != "") c[$1] = 1; next }
    $1 == "kernel" { kn[++k] = $2; kv[k] = $6; next }
    $1 == "dkms" { dn[++d] = $2; dt[d] = $6 }
    END {
      for (i = 1; i <= d; i++) {
        n = split(dt[i], t, ",")
        for (j = 1; j <= k; j++)
          if (((dn[i] in c) || (kn[j] in c)) && (!(dn[i] in scope) || index(scope[dn[i]], "," kn[j] ",")))
            for (x = 1; x <= n; x++) print kn[j] "\t" kv[j] "\t" dn[i] "\t" t[x]
      }
    }' <(printf '%s\n' "$SCOPES") <(printf '%s\n' "$changed") <(printf '%s\n' "$packages")
}

plan_for() { # plan_for <channel db> [since db]: sets PACKAGES, CHANGED, PAIRS
  local fresh="" previous="" published repos="" ours
  [[ -z $local_dir ]] || fresh=$(read_local)
  [[ -z ${2:-} ]] || previous=$(read_db "$2")
  published=$(read_db "$1")
  if [[ -n $REPOS ]] && repos_needed "$published" "$fresh" "$previous"; then
    load_repo_dbs
    repos=$(read_repos "$REPO_CHANNEL" "${repo_dbs[@]}")
    # This repository's own copy, published or fresh, is what pacman installs.
    ours=$(printf '%s\n%s\n' "$published" "$fresh" | awk -F'\t' '$1 == "dkms" { print $2 }')
    repos=$(awk -F'\t' 'FNR == 1 { file++ } file == 1 { if ($0 != "") o[$0] = 1; next }
      ($2 in o) { print "check-dkms: note: " $2 " is built here too; the Arch copy is not checked (drop its repo= from ci/dkms-packages)" > "/dev/stderr"; next } { print }' \
      <(printf '%s\n' "$ours") <(printf '%s\n' "$repos"))
    ARCH_SOURCED=$(awk -F'\t' '$1 == "dkms" { print $2 }' <<<"$repos")
  fi
  PACKAGES=$(compose "$(printf '%s\n%s\n' "$published" "$repos" | sed '/^$/d')" "$fresh")
  # Listed DKMS packages, and every fresh one: a pull request that adds a new
  # recipe is checked before it publishes, even though master's registry does
  # not list it yet.
  PACKAGES=$(awk -F'\t' 'FNR == 1 { file++ }
    file == 1 { if ($0 != "") ok[$0] = 1; next }
    file == 2 { if ($1 == "dkms") ok[$2] = 1; next }
    $1 == "kernel" || ($1 == "dkms" && ($2 in ok))' \
    <(printf '%s\n' "$LISTED") <(printf '%s\n' "$fresh") <(printf '%s\n' "$PACKAGES"))
  if [[ -n $fresh ]]; then
    awk -F'\t' -v L="$LISTED" 'BEGIN { n = split(L, l, "\n"); for (i = 1; i <= n; i++) ok[l[i]] = 1 }
      $1 == "dkms" && !($2 in ok) { print "check-dkms: note: " $2 " is not in ci/dkms-packages yet; checking it against every kernel" > "/dev/stderr" }' <<<"$fresh"
  fi
  CHANGED=$(changed_names "$PACKAGES" "$fresh" "$previous")
  PAIRS=$(pairs "$PACKAGES" "$CHANGED")
}

# repo= packages can only pair with a kernel. They are needed when every
# package is checked, with --from-repos, or when a kernel changes: a fresh one,
# or one whose version differs from --since's.
repos_needed() { # repos_needed <published> <fresh> <previous>
  ((from_repos)) && return 0
  [[ -n $2 || -n $3 ]] || return 0
  if [[ -n $2 ]]; then
    awk -F'\t' '$1 == "kernel" { f = 1 } END { exit !f }' <<<"$2"
    return
  fi
  awk -F'\t' 'FNR == 1 { file++ } file == 1 { v[$2] = $3; next }
    $1 == "kernel" && v[$2] != $3 { f = 1 } END { exit !f }' <(printf '%s\n' "$3") <(printf '%s\n' "$1")
}

# plan reads the repo files databases it was given; run downloads them.
load_repo_dbs() {
  [[ $mode == run ]] || return 0
  local repo
  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    curl -fsSL --retry 3 -o "$work/$repo.files" "$(repo_url "$channel" "$repo")/$repo.files" ||
      die "cannot download $repo.files from the $channel mirror"
    repo_dbs+=("$repo=$work/$repo.files")
  done < <(cut -f2 <<<"$REPOS" | sort -u)
}

print_plan() {
  awk -F'\t' '{ print $1 "\t" $2 "\t" $3 "\t" $6 }' <<<"$PACKAGES"
  if [[ -n $PAIRS ]]; then
    awk -F'\t' '{ print "pair\t" $1 " " $2 "\t" $3 " " $4 }' <<<"$PAIRS"
  else
    echo "nothing to check"
  fi
}

case $mode in
  needs)
    # Exit 0, naming them, when --local holds a kernel or DKMS package for
    # this architecture, or a package the channel publishes as one: a recipe
    # that lost its headers tree or dkms.conf must reach the check, which
    # refuses it. 1 when there is nothing to check. Runs on the CI host,
    # before any container: a pull request with neither skips the check.
    [[ -n $local_dir ]] || die "needs needs --local"
    published=""
    if [[ -n $channel ]]; then
      work=$(mktemp -d)
      trap 'rm -rf "$work"' EXIT
      curl -fsSL --retry 3 -o "$work/channel.files" "$PKGS_BASE/$channel/$arch/omarchy.files" || die "cannot download $channel/$arch/omarchy.files"
      files_db=$work/channel.files
    fi
    [[ -z $files_db ]] || published=$(read_db "$files_db" | awk -F'\t' '$1 == "kernel" || $1 == "dkms" { print $2 }')
    found=1
    for pkg in "$local_dir"/*.pkg.tar.*; do
      [[ -f $pkg && $pkg != *.sig ]] || continue
      info=$(bsdtar -xOf "$pkg" .PKGINFO) || die "cannot read $pkg"
      name=$(awk -F' = ' '$1 == "pkgname" { print $2; exit }' <<<"$info")
      parch=$(awk -F' = ' '$1 == "arch" { print $2; exit }' <<<"$info")
      [[ $parch == "$arch" || $parch == any ]] || continue
      list=$(bsdtar -tf "$pkg") || die "cannot list $pkg"
      kind=$(classify <<<"$list" | cut -f1)
      if [[ $kind == kernel || $kind == dkms ]]; then
        echo "${pkg##*/} ($kind)"
        found=0
      elif grep -qxF -- "$name" <<<"$published"; then
        echo "${pkg##*/} (published as a kernel or DKMS package)"
        found=0
      fi
    done
    exit "$found"
    ;;

  fingerprint)
    # The repo= packages' versions on the channel's mirror and the channel's
    # headers packages: a daily --from-repos run that finds these unchanged
    # since its last green run has nothing new to build. Runs on the CI host,
    # which has GNU tar but not bsdtar.
    [[ -n $channel ]] || die "fingerprint needs --channel"
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    curl -fsSL --retry 3 -o "$work/channel.files" "$PKGS_BASE/$channel/$arch/omarchy.files" || die "cannot download $channel/$arch/omarchy.files"
    # Every read is checked: a fingerprint that silently lost a part would be
    # remembered as built and hide that part's later updates.
    entries=$(tar -tf "$work/channel.files") || die "cannot read $channel/$arch/omarchy.files"
    kernels=$(awk -F/ 'NF > 1 && $1 ~ /-headers-/ { print $1 }' <<<"$entries" | sort -u)
    [[ -n $kernels ]] || die "$channel/$arch publishes no headers package"
    printf '%s\n' "$kernels"
    while IFS=$'\t' read -r name repo; do
      [[ -n $name ]] || continue
      if [[ ! -f $work/$repo.db ]]; then
        curl -fsSL --retry 3 -o "$work/$repo.db" "$(repo_url "$channel" "$repo")/$repo.db" || die "cannot download $repo.db from the $channel mirror"
        tar -tf "$work/$repo.db" | awk -F/ 'NF > 1 { print $1 }' | sort -u >"$work/$repo.list" || die "cannot read $repo.db from the $channel mirror"
      fi
      found=$(grep -E "^${name//./\\.}-[0-9]" "$work/$repo.list" || true)
      [[ -n $found ]] || die "$repo on the $channel mirror has no $name"
      printf '%s\n' "$found"
    done <<<"$REPOS"
    ;;

  plan)
    [[ -f $files_db ]] || die "plan needs --files-db"
    [[ -z $since_db || -f $since_db ]] || die "--since-db $since_db is not a file"
    all=$(read_db "$files_db")
    status=0
    check_registry "$all" || status=1
    plan_for "$files_db" "$since_db"
    print_plan
    exit "$status"
    ;;

  container)
    [[ -n $channel ]] || die "container needs --channel"
    image=$X86_64_IMAGE
    [[ $arch == x86_64 ]] || image=$AARCH64_IMAGE
    mounts=(-v "$ROOT:/src:ro")
    args=(run --arch "$arch" --channel "$channel")
    [[ -z $since ]] || args+=(--since "$since")
    [[ -z $only ]] || args+=(--packages "$only")
    ((!from_repos)) || args+=(--from-repos)
    if [[ -n $local_dir ]]; then
      mounts+=(-v "$(realpath "$local_dir"):/local:ro")
      args+=(--local /local)
    fi
    if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
      mounts+=(-v "$GITHUB_STEP_SUMMARY:/summary.md")
      args=(env GITHUB_STEP_SUMMARY=/summary.md bash /src/bin/check-dkms "${args[@]}")
    else
      args=(bash /src/bin/check-dkms "${args[@]}")
    fi
    exec docker run --rm "${mounts[@]}" "$image" "${args[@]}"
    ;;

  run)
    [[ -n $channel ]] || die "run needs --channel"
    ((EUID == 0)) || die "run installs packages; run it as root in a disposable system"
    work=$(mktemp -d)
    curl -fsSL --retry 3 -o "$work/channel.files" "$PKGS_BASE/$channel/$arch/omarchy.files" || die "cannot download $channel/$arch/omarchy.files"
    if [[ -n $since ]]; then
      curl -fsSL --retry 3 -o "$work/since.files" "$PKGS_BASE/$since/$arch/omarchy.files" || die "cannot download $since/$arch/omarchy.files"
    fi
    published=$(read_db "$work/channel.files")
    check_registry "$published" || exit 1
    plan_for "$work/channel.files" "${since:+$work/since.files}"
    echo "==> $channel/$arch${since:+, changes since $since}${local_dir:+, with $local_dir}:"
    print_plan | column -t -s $'\t'
    if [[ -z $PAIRS ]]; then
      echo "### DKMS on $channel/$arch: nothing to check" | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}"
      exit 0
    fi

    # The Arch packages the channel's machines build with: its own mirror
    # snapshot (mirror_server). pacman 7 cannot sandbox its downloads on a
    # kernel without Landlock, which CI runners can be.
    echo "Server = $(mirror_server "$channel")" >/etc/pacman.d/mirrorlist
    if [[ $arch == aarch64 ]]; then
      pacman-key --init >/dev/null 2>&1
      pacman-key --populate archlinuxarm >/dev/null 2>&1
    fi
    if ! grep -qw landlock /sys/kernel/security/lsm 2>/dev/null && ! grep -q '^DisableSandbox' /etc/pacman.conf; then
      sed -i '/^\[options\]/a DisableSandboxFilesystem\nDisableSandboxSyscalls' /etc/pacman.conf
    fi
    pacman -Syu --noconfirm --needed dkms base-devel bc cpio pahole libarchive curl >/dev/null

    # Sets FETCHED to a verified local copy of a package line's file.
    fetch() {
      local file=$1 sha=$2
      if [[ $sha == - ]]; then
        FETCHED=$file
        return 0
      fi
      # repo= packages carry their mirror URL; this repository's, a file name.
      local url=$PKGS_BASE/$channel/$arch/$file
      [[ $file != https://* ]] || url=$file
      FETCHED=$work/${file##*/}
      curl -fsSL --retry 3 -o "$FETCHED" "$url" || die "cannot download $url"
      echo "$sha  $FETCHED" | sha256sum -c --quiet - || die "$file does not match its database's SHA-256"
    }
    line_of() { awk -F'\t' -v n="$1" '$2 == n' <<<"$PACKAGES"; }

    for name in $(cut -f1 <<<"$PAIRS" | sort -u); do
      IFS=$'\t' read -r _ _ _ file sha kver <<<"$(line_of "$name")"
      fetch "$file" "$sha"
      echo "==> Installing $name ($kver)"
      pacman -U --noconfirm --needed "$FETCHED" >/dev/null || die "cannot install $name"
    done
    for name in $(cut -f3 <<<"$PAIRS" | sort -u); do
      IFS=$'\t' read -r _ _ _ file sha _ <<<"$(line_of "$name")"
      fetch "$file" "$sha"
      bsdtar -xpf "$FETCHED" -C / 'usr/src/*' || die "cannot unpack $name"
    done

    results=()
    failed=0
    while IFS=$'\t' read -r kname kver dname tree; do
      # The module and version the way Arch's DKMS hook reads them: the source
      # directory's name, split at its last dash.
      module=${tree%-*} version=${tree##*-}
      dkms add -m "$module" -v "$version" >/dev/null 2>&1 || true
      echo "==> $dname: $module/$version against $kver"
      status=0
      timeout 3600 dkms build --force -m "$module" -v "$version" -k "$kver" >"$work/build.log" 2>&1 || status=$?
      case $status in
        0) result=built ;;
        77) result="excluded (BUILD_EXCLUSIVE)" ;;
        *)
          result=FAILED
          failed=1
          tail -n 40 "$work/build.log" || true
          log=/var/lib/dkms/$module/$version/build/make.log
          if [[ -f $log ]]; then
            echo "--- $log"
            grep -m 20 -E 'error|Error' "$log" || true
          fi
          ;;
      esac
      echo "    $result"
      results+=("| $dname | $module $version | $kname $kver | $result |")
    done <<<"$PAIRS"

    {
      echo "### DKMS on $channel/$arch${since:+, changes since $since}${local_dir:+, with this build}"
      echo
      echo "| Package | Module | Kernel | Result |"
      echo "|---|---|---|---|"
      printf '%s\n' "${results[@]}"
    } | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}"
    exit "$failed"
    ;;

  *) usage ;;
esac
