#!/bin/bash
# Decide what "Unpublish retired packages" may take out, per channel and
# architecture.
#
#   unpublish-plan --channels "<edge rc stable>" <pkgbase...>
#
# An entry can go from a channel and architecture no recipe on this checkout
# publishes it to: its recipe is gone, it no longer builds for that
# architecture (pinta is aarch64-only), or its channels leave that channel
# out (omarchy-dev is edge-only, so a copy in stable is a leftover). One a
# recipe still publishes there would come back on its next publish, so it is
# kept, and a package kept everywhere it was asked for is refused: that keeps
# a typo from pulling a live package out of every channel.
#
# A pkgbase is matched to its recipe through the pkgbase the recipe builds,
# which is not always its directory's name (yaru-icon-theme builds yaru), as
# promote-channel does, and through the packages the channel holds under it:
# one a recipe that publishes there still builds under another pkgbase is
# kept, since its next publish or promotion replaces the entry by name. That
# reads each channel's database (OMARCHY_PUBLISHED_REPO_URL, default
# https://pkgs.omarchy.org, under OMARCHY_PUBLISH_PREFIX), with the rule
# bin/check-channel-drift applies (package_pkgbase_publisher); a database
# that can't be read in full stops the plan.
#
# Prints one RETIRE_<CHANNEL>_<ARCH>="<pkgbase...>" line per channel and
# architecture, for $GITHUB_ENV; refusals go to stderr as GitHub errors.
# OMARCHY_PKGBUILDS names another recipe directory (tests).
set -euo pipefail
ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$ROOT/helpers/package-metadata.sh"
source "$ROOT/helpers/channel-db.sh"
PKGBUILDS_DIR=${OMARCHY_PKGBUILDS:-$ROOT/pkgbuilds}
REPO_URL=${OMARCHY_PUBLISHED_REPO_URL:-https://pkgs.omarchy.org}
PREFIX=${OMARCHY_PUBLISH_PREFIX:-}
ARCHES=(x86_64 aarch64)

channels=""
if [[ ${1:-} == --channels ]]; then
  channels=${2:-}
  shift $(( $# > 1 ? 2 : 1 ))
fi
[[ -n $channels && $# -gt 0 ]] || { echo "::error::usage: unpublish-plan --channels \"<edge rc stable>\" <pkgbase...>" >&2; exit 1; }
for c in $channels; do
  [[ $c == edge || $c == rc || $c == stable ]] || { echo "::error::Unknown channel: $c" >&2; exit 1; }
done

# A recipe that cannot be read in full would drop out of the index, read as
# gone and be retired, so nothing is planned (package_index_pkgbases).
package_index_pkgbases "${ARCHES[@]}" || { echo "::error::Not planning anything" >&2; exit 1; }

# The entries of every channel and architecture asked for.
entries=$(mktemp)
trap 'rm -f "$entries"' EXIT
for c in $channels; do
  for arch in "${ARCHES[@]}"; do
    channel_db_entries "$REPO_URL/${PREFIX:+$PREFIX/}$c/$arch/omarchy.db" "$c" "$arch" >> "$entries" ||
      { echo "::error::Not planning anything" >&2; exit 1; }
  done
done

declare -A retire=()
for p in "$@"; do
  # makepkg's rule (lint_one_pkgname): alphanumerics and +_.@-, not starting
  # with - or ., so every pkgbase check-channel-drift can name is accepted.
  [[ $p =~ ^[A-Za-z0-9+_@][A-Za-z0-9+_.@-]*$ ]] || { echo "::error::Not a package name: $p" >&2; exit 1; }
  kept=0 asked=0
  for c in $channels; do
    for arch in "${ARCHES[@]}"; do
      asked=$((asked + 1))
      held=$(awk -F'\t' -v c="$c" -v a="$arch" -v b="$p" '$1 == c && $2 == a && $3 == b { print $4 }' "$entries")
      names=()
      [[ -z $held ]] || mapfile -t names <<<"$held"
      if pkgdir=$(package_pkgbase_publisher "$p" "$c" "$arch" "${names[@]}"); then
        echo "Keeping $p in $c/$arch: pkgbuilds/${pkgdir##*/} still publishes it there" >&2
        kept=$((kept + 1))
      else
        retire[$c/$arch]+=" $p"
      fi
    done
  done
  if (( kept == asked )); then
    echo "::error::$p is still published to every channel and architecture asked for; remove its recipe or narrow its channels first" >&2
    exit 1
  fi
done

for c in edge rc stable; do
  for arch in "${ARCHES[@]}"; do
    list=${retire[$c/$arch]:-}
    echo "RETIRE_${c^^}_${arch^^}=${list# }"
  done
done
