# Maintainer: Noa Himesaka <himesaka@noa.codes>
pkgname=apple-bcm-firmware-fetcher
pkgver=1
pkgrel=1
pkgdesc="Fetches Wi-Fi and Bluetooth firmware for T2 Macs from the on-disk macOS volume (t2linux firmware.sh, method 4 only)"
url="https://wiki.t2linux.org/guides/wifi-bluetooth/"
arch=('any')
license=('MIT')
depends=('bash' 'python' 'kmod' 'util-linux' 'tar' 'coreutils' 'gawk')
optdepends=('linux-t2: kernel with the in-tree APFS driver needed to read the macOS volume'
            'linux-lts-t2: LTS kernel with the in-tree APFS driver needed to read the macOS volume')
conflicts=('apple-bcm-firmware')
install="$pkgname.install"
source=("$pkgname.sh"
        'LICENSE')
sha256sums=('873f78849627293781c6eb7c7a36d9a621a340ce8aaba292023eefa6aa481ba6'
            '6c903cc39c8e90a40258d8ade6ebad7d8fe92c42affd9ce6d479db9fc55be860')

package() {
  install -Dm755 "$srcdir/$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
