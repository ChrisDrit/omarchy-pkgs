# Fetching firmware is best-effort: this hook must never fail the pacman
# transaction, so installs inside VMs, containers and CI still complete.
post_install() {
	local vendor
	vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
	if [ -n "$vendor" ] && [ "$vendor" != "Apple Inc." ]; then
		cat <<- MSG
		==> Not running on an Apple Mac (DMI vendor: $vendor); skipping firmware fetch.
		    Run 'apple-bcm-firmware-fetcher' as root on the target Mac.
		MSG
		return 0
	fi
	if ! /usr/bin/apple-bcm-firmware-fetcher; then
		cat <<- MSG
		==> Could not fetch the Wi-Fi/Bluetooth firmware from the macOS volume.
		    Run 'apple-bcm-firmware-fetcher' as root once macOS is reachable, or
		    follow another method at https://wiki.t2linux.org/guides/wifi-bluetooth/
		MSG
	fi
	return 0
}

pre_remove() {
	local list=/var/lib/apple-bcm-firmware-fetcher/installed-files
	if [ -f "$list" ]; then
		while read -r f; do
			rm -f "/lib/firmware/brcm/$f"
		done < "$list"
		rm -rf /var/lib/apple-bcm-firmware-fetcher
	fi
	return 0
}
