pkgbase=linux-t2
pkgver=7.2.11.arch1
pkgrel=1.1
pkgdesc='Linux for T2 Macs'
url='https://github.com/archlinux/linux'
arch=(
  x86_64
)
license=(GPL-2.0-only)
makedepends=(
  bc
  binutils
  cpio
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd

)
options=(
  !debug
  !strip
)
_srcname=linux-${pkgver%.*}
_srctag=v${pkgver%.*}-${pkgver##*.}
# t2linux/linux-t2-patches at e16720782ee30fac38486b6c58d32443899c136a, whose
# version file reads KVER=7.2.10: the set made for this kernel series. The
# files live beside this PKGBUILD, each with its checksum, so a kernel bump
# shows the T2 drivers' diff in review and the build fetches nothing from that
# repository. extra_config is the same commit's config fragment.
_t2linux_patches=(
  1001-Add-t2bce-driver-stack.patch
  1002-Integrate-t2bce-driver-stack.patch
  2008-i915-4-lane-quirk-for-mbp15-1.patch
  2009-apple-gmux-allow-switching-to-igpu-at-probe.patch
  3001-applesmc-convert-static-structures-to-drvdata.patch
  3002-applesmc-make-io-port-base-addr-dynamic.patch
  3003-applesmc-switch-to-acpi_device-from-platform.patch
  3004-applesmc-key-interface-wrappers.patch
  3005-applesmc-basic-mmio-interface-implementation.patch
  3006-applesmc-fan-support-on-T2-Macs.patch
  3007-applesmc-Add-iMacPro-to-applesmc_whitelist.patch
  3008-applesmc-make-applesmc_remove-void.patch
  3009-applesmc-battery-charge-limiter.patch
  4001-asahi-trackpad.patch
  4003-HID-apple-ignore-the-trackpad-on-T2-Macs.patch
  4004-HID-magicmouse-Add-support-for-trackpads-found-on-T2.patch
  5001-HID-appletb-kbd-add-option-to-switch-default-layer-o.patch
  5002-drm-appletbdrm-Add-suspend-and-resume-support.patch
  6001-drm-amd-pm-Fix-boot-problems-in-5300.patch
  7001-drm-i915-fbdev-Discard-BIOS-framebuffers-exceeding-h.patch
  7003-amdgpu-add-support-for-5K.patch
  8001-Add-APFS-driver.patch
  8002-Necessary-modifications-to-build-APFS-with-the-kerne.patch
  9001-ACPI-x86-Apple-T2-systems-need-early-CPU-offlining.patch
  9002-Bluetooth-hci_event-strip-Broadcom-vendor-bits-from-adv-type.patch
  9003-PATCH-wireless-next-v2-wifi-brcmfmac-Improve-D3-substate-entering-timeout-handling.patch
)
source=(
  https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/${_srcname}.tar.{xz,sign}
  $url/releases/download/$_srctag/linux-$_srctag.patch.zst{,.sig}

  # t2linux
  extra_config
  "${_t2linux_patches[@]}"
)
source_x86_64=(config.x86_64)
